            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) Binary file to ingest."
                },
                {
                  "key": "metadata",
                  "value": "<string>",
                  "type": "text",
                  "description": "Stringified JSON with a custom_metadata object (max 15 fields, <= 2 KB encoded)."
