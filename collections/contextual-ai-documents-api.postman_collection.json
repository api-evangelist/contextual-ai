          "name": "Ingest Document",
          "request": {
            "name": "Ingest Document",
            "description": {
              "content": "Ingest a document (PDF, HTML, DOC(X), PPT(X), PNG, JPG/JPEG) into a datastore. The document is parsed and chunked for retrieval.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datastores",
                ":datastore_id",
                "documents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "datastore_id",
                  "description": "(Required) ID of the datastore."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
