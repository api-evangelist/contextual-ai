      "item": [
        {
          "id": "6aacc709-6e96-4302-a073-927437d062e6",
          "name": "Query Agent",
          "request": {
            "name": "Query Agent",
            "description": {
              "content": "Send a conversation to an agent and receive a grounded response with attributions, retrieval contents, and groundedness scores. Set stream=true to receive a Server-Sent Events token stream.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agents",
                ":agent_id",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "retrievals_only",
                  "value": "false",
                  "description": "Fetch retrieval content and metadata only, skipping generation."
                },
                {
                  "disabled": false,
                  "key": "include_retrieval_content_text",
                  "value": "false",
                  "description": "Include the text of retrieved contents in the response."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "agent_id",
                  "description": "(Required) ID of the agent."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\"\n    },\n    {\n      \"role\": \"<string>\",\n      \"content\": \"<string>\"\n    }\n  ],\n  \"stream\": false,\n  \"conversation_id\": \"<uuid>\",\n  \"llm_model_id\": \"<string>\",\n  \"documents_filters\": \"<object>\",\n  \"override_configuration\": \"<object>\"\n}",
