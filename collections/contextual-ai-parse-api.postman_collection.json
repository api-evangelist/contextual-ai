          "name": "Parse File",
          "request": {
            "name": "Parse File",
            "description": {
              "content": "Submit a document (PDF, DOC(X), PPT(X), PNG, JPG/JPEG; max 300 MB, 2000 pages) to be parsed into AI-ready markdown. Returns a job_id; poll the status and results endpoints. Results are retained 30 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "parse"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "raw_file",
                  "type": "file",
                  "description": "(Required) File to parse."
                },
                {
                  "key": "parse_mode",
                  "value": "standard",
                  "type": "text",
                  "description": "basic (text-only) or standard (multimodal). (This can only be one of basic,standard)"
                },
                {
                  "key": "enable_document_hierarchy",
                  "value": "<boolean>",
                  "type": "text",
                  "description": "Add an inferred table of contents (beta)."
                },
                {
                  "key": "enable_split_tables",
                  "value": "<boolean>",
                  "type": "text",
                  "description": "Split large tables by row, repeating headers."
                },
                {
                  "key": "max_split_table_cells",
                  "value": "<integer>",
                  "type": "text",
                  "description": "Cell-count threshold above which tables are split."
                },
                {
                  "key": "page_range",
                  "value": "<string>",
                  "type": "text",
                  "description": "0-based pages to parse, e.g. \"0,1,2\" or \"0-2,5\"."
                }
              ]
            }
